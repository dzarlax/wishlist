# Admin Password
# Change this to your desired password
ADMIN_PASSWORD=your_secure_password_here

# Server Port (optional)
# PORT=3000

# Gemini API Key for AI-powered gift parsing
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for gift parsing
GEMINI_MODEL=gemini-2.5-flash

# Optional generic OIDC SSO. Keep all values unset when disabled.
# The callback URL is APP_URL/api/auth/sso/callback.
# OIDC_ENABLED=false
# OIDC_ISSUER=https://issuer.example.test
# OIDC_CLIENT_ID=wishlist-synthetic-client
# OIDC_CLIENT_SECRET=replace-with-client-secret
# APP_URL=https://wishlist.example.test

# Alternatively, keep using legacy Authentik SSO. Do not enable both providers.
# AUTHENTIK_ENABLED=true
# AUTHENTIK_URL=https://authentik.example.test
# AUTHENTIK_CLIENT_ID=wishlist-synthetic-client
# AUTHENTIK_CLIENT_SECRET=replace-with-client-secret
